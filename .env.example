# Токен вашого Telegram-бота (можна отримати у @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_12345

# API-ключ для ШІ-асистента (OpenAI API або сумісний)
API_KEY=sk-proj-your_openai_api_key_here

# Базовий URL для ШІ (якщо використовуєте офіційний OpenAI, залиште як є)
BASE_URL=https://api.openai.com/v1

# Назва моделі (наприклад: gpt-4o, gpt-4o-mini, gpt-3.5-turbo)
MODEL_NAME=gpt-4o-mini